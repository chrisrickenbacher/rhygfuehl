---
import Layout from '../layouts/Layout.astro';
import MetricCard from '../components/MetricCard.astro';
import SwimPrognosis from '../components/SwimPrognosis.astro';
import waterData from '../../data/data/waterData.json';
import airData from '../../data/data/airData.json';
import levelData from '../../data/data/levelData.json';
import qualityData from '../../data/data/qualityData.json';
import de from '../locales/de.json';

const waterTemp = waterData.actualValue.toFixed(1);
const airTemp = airData.actualValue.toFixed(1);
const waterLevel = levelData.actualValue.toFixed(2);

const seoDescription = de.seo.description
	.replace('%airTemp%', airTemp)
	.replace('%waterTemp%', waterTemp);

const getPrognosisLabel = (q: number, t: any) => {
	if (q === 3) return t.prognosisExcellent;
	if (q === 2) return t.prognosisGood;
	return t.prognosisDiscouraged;
};

const getQualityLabel = (q: number, t: any) => {
	if (q === 3) return t.qualityExcellent;
	if (q === 2) return t.qualityGood;
	return t.qualityDiscouraged;
};

const getSafetyLabel = (s: number, t: any) => {
	if (s === 3) return t.safetySafe;
	if (s === 2) return t.safetyCaution;
	return t.safetyDiscouraged;
};

const prognosisLabel = getPrognosisLabel(qualityData.quality, de);
const qualityLabel = getQualityLabel(qualityData.indices?.quality, de);
const safetyLabel = getSafetyLabel(qualityData.indices?.safety, de);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": de.faqQ1,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": de.faqA1.replace('%waterTemp%', waterTemp)
			}
		},
		{
			"@type": "Question",
			"name": de.faqQ2,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": de.faqA2.replace('%airTemp%', airTemp)
			}
		},
		{
			"@type": "Question",
			"name": de.faqQ3,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": de.faqA3
					.replace('%prognosis%', prognosisLabel)
					.replace('%quality%', qualityLabel)
					.replace('%safety%', safetyLabel)
			}
		}
	]
};
---

<Layout title={de.seo.title} description={seoDescription} lang="de">
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	
	<div class="space-y-4">
		<SwimPrognosis 
			quality={qualityData.quality}
			indices={qualityData.indices}
			lastUpdate={qualityData.lastUpdate}
			updateLabel={de.updateLabel}
			t={de}
			data={qualityData.data}
		/>

		<MetricCard 
			id="water-chart"
			title={de.waterTemp}
			value={waterTemp}
			unit="°C"
			description={de.waterTempDesc}
			lastUpdate={waterData.lastUpdate}
			updateLabel={de.updateLabel}
			dataWeek={waterData.chart.week}
			dataMonth={waterData.chart.month}
			textWeek={de.week}
			textMonth={de.month}
			textToday={de.today}
		/>

		<MetricCard 
			id="air-chart"
			title={de.airTemp}
			value={airTemp}
			unit="°C"
			description={de.airTempDesc}
			lastUpdate={airData.lastUpdate}
			updateLabel={de.updateLabel}
			dataWeek={airData.chart.week}
			dataMonth={airData.chart.month}
			textWeek={de.week}
			textMonth={de.month}
			textToday={de.today}
		/>

		<MetricCard 
			id="level-chart"
			title={de.waterLevel}
			value={`${waterLevel > 0 ? '+' : ''}${waterLevel}`}
			unit="m"
			description={de.waterLevelDesc}
			lastUpdate={levelData.lastUpdate}
			updateLabel={de.updateLabel}
			dataWeek={levelData.chart.week}
			dataMonth={levelData.chart.month}
			textWeek={de.week}
			textMonth={de.month}
			textToday={de.today}
		/>
	</div>
</Layout>
